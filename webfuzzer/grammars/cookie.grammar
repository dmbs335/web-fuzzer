# =============================================================================
# HTTP Cookie Grammar — RFC 6265bis (Cookies: HTTP State Management Mechanism)
# Also covers: SameSite, __Host-/__Secure- prefixes, Priority,
#              Partitioned, edge cases for parser differential testing
# =============================================================================

!root <set_cookie_header>
!max_depth 6

# =============================================================================
# Set-Cookie header (server → client)
# =============================================================================
<set_cookie_header> = <cookie_name>=<cookie_value><cookie_attrs>
<set_cookie_header> = <cookie_name>=<cookie_value>
<set_cookie_header> = <prefixed_cookie_name>=<cookie_value><cookie_attrs>

# =============================================================================
# Cookie header (client → server)
# =============================================================================
<cookie_header> = <cookie_pair>
<cookie_header> = <cookie_pair>; <cookie_header>

<cookie_pair> = <cookie_name>=<cookie_value>

# =============================================================================
# Cookie name (RFC 6265bis §4.1.1 — token per RFC 7230)
# Valid: any CHAR except CTLs, separators
# =============================================================================
<cookie_name> = <string min=1 max=32 charset=lower>
<cookie_name> = <string min=1 max=16 charset=alphanumeric>
<cookie_name> = <string min=3 max=12 charset=lower>_<string min=3 max=12 charset=lower>
<cookie_name> = session
<cookie_name> = sessionid
<cookie_name> = JSESSIONID
<cookie_name> = PHPSESSID
<cookie_name> = csrftoken
<cookie_name> = _csrf
<cookie_name> = token
<cookie_name> = auth
<cookie_name> = sid
<cookie_name> = id
<cookie_name> = user
<cookie_name> = lang
<cookie_name> = theme
<cookie_name> = _ga
<cookie_name> = _gid
<cookie_name> = _fbp

# --- cookie name edge cases ---
<cookie_name> = <string min=1 max=1 charset=lower>
<cookie_name> = <string min=64 max=128 charset=alphanumeric>
<cookie_name> = <string min=3 max=8 charset=lower>.<string min=3 max=8 charset=lower>
<cookie_name> = $<string min=3 max=12 charset=lower>
<cookie_name> = <string min=3 max=8 charset=lower>-<string min=3 max=8 charset=lower>

# =============================================================================
# Cookie name prefixes (RFC 6265bis §4.1.3)
# =============================================================================
<prefixed_cookie_name> = __Host-<string min=3 max=20 charset=lower>
<prefixed_cookie_name> = __Secure-<string min=3 max=20 charset=lower>
<prefixed_cookie_name> = __Host-session
<prefixed_cookie_name> = __Secure-token
<prefixed_cookie_name> = __Host-id
<prefixed_cookie_name> = __Secure-csrf

# Edge cases: incorrect prefix casing / partial prefix
<prefixed_cookie_name> = __host-<string min=3 max=12 charset=lower>
<prefixed_cookie_name> = __secure-<string min=3 max=12 charset=lower>
<prefixed_cookie_name> = __HOST-<string min=3 max=12 charset=lower>
<prefixed_cookie_name> = __SECURE-<string min=3 max=12 charset=lower>
<prefixed_cookie_name> = __Host<string min=3 max=12 charset=lower>
<prefixed_cookie_name> = __Secure<string min=3 max=12 charset=lower>

# =============================================================================
# Cookie value (RFC 6265bis §4.1.1)
# cookie-value = *cookie-octet / ( DQUOTE *cookie-octet DQUOTE )
# =============================================================================
<cookie_value> = <string min=1 max=64 charset=alphanumeric>
<cookie_value> = "<string min=1 max=64 charset=alphanumeric>"
<cookie_value> = <string min=8 max=64 charset=hex>
<cookie_value> = <base64_value>
<cookie_value> = <jwt_like_value>
<cookie_value> = <int min=0 max=999999999>
<cookie_value> = true
<cookie_value> = false
<cookie_value> = <url_encoded_value>

# Empty value edge case
<cookie_value> =

# Quoted value edge cases
<cookie_value> = "<string min=1 max=32 charset=alphanumeric> <string min=1 max=32 charset=alphanumeric>"
<cookie_value> = ""

# Long value
<cookie_value> = <string min=128 max=256 charset=alphanumeric>
<cookie_value> = <string min=1024 max=2048 charset=alphanumeric>

<base64_value> = <string min=20 max=44 charset=alphanumeric>==
<base64_value> = <string min=20 max=44 charset=alphanumeric>=
<base64_value> = <string min=22 max=44 charset=alphanumeric>

<jwt_like_value> = <string min=20 max=40 charset=alphanumeric>.<string min=20 max=80 charset=alphanumeric>.<string min=20 max=44 charset=alphanumeric>

<url_encoded_value> = <string min=3 max=10 charset=lower>%3D<string min=3 max=10 charset=alphanumeric>
<url_encoded_value> = %22<string min=5 max=20 charset=alphanumeric>%22
<url_encoded_value> = <string min=3 max=8 charset=lower>%26<string min=3 max=8 charset=lower>%3D<string min=3 max=8 charset=alphanumeric>

# =============================================================================
# Cookie attributes (RFC 6265bis §4.1.2)
# =============================================================================
<cookie_attrs> = <cookie_attr>
<cookie_attrs> = <cookie_attr><cookie_attrs>

<cookie_attr> = ; Expires=<cookie_date>
<cookie_attr> = ; Max-Age=<max_age_value>
<cookie_attr> = ; Domain=<domain_value>
<cookie_attr> = ; Path=<path_value>
<cookie_attr> = ; Secure
<cookie_attr> = ; HttpOnly
<cookie_attr> = ; SameSite=<samesite_value>
<cookie_attr> = ; Partitioned
<cookie_attr> = ; Priority=<priority_value>

# Edge cases: varied whitespace and casing
<cookie_attr> = ;Secure
<cookie_attr> = ;  HttpOnly
<cookie_attr> = ; secure
<cookie_attr> = ; httponly
<cookie_attr> = ; SECURE
<cookie_attr> = ; HTTPONLY
<cookie_attr> = ; samesite=<samesite_value>
<cookie_attr> = ; SAMESITE=<samesite_value>
<cookie_attr> = ; domain=<domain_value>
<cookie_attr> = ; path=<path_value>
<cookie_attr> = ; expires=<cookie_date>
<cookie_attr> = ; max-age=<max_age_value>

# Unknown attributes (should be ignored per spec)
<cookie_attr> = ; <string min=3 max=15 charset=lower>=<string min=1 max=20 charset=alphanumeric>
<cookie_attr> = ; <string min=3 max=15 charset=lower>

# =============================================================================
# Expires (RFC 6265bis §5.2.1 — subset of HTTP-date per RFC 7231)
# =============================================================================
<cookie_date> = <day_name>, <day> <month> <year> <time> GMT
<cookie_date> = <day_name>, <day>-<month>-<short_year> <time> GMT

# Obsolete but accepted formats
<cookie_date> = <day_name> <month> <day> <time> <year>
<cookie_date> = <day_name>, <day>-<month>-<year> <time> GMT

# Edge case: epoch / far future / invalid
<cookie_date> = Thu, 01 Jan 1970 00:00:00 GMT
<cookie_date> = Fri, 31 Dec 9999 23:59:59 GMT
<cookie_date> = Thu, 01 Dec 1994 16:00:00 GMT
<cookie_date> = Sat, 01 Jan 2000 00:00:00 GMT

<day_name> = Mon
<day_name> = Tue
<day_name> = Wed
<day_name> = Thu
<day_name> = Fri
<day_name> = Sat
<day_name> = Sun

<day> = <int min=1 max=31>
<day> = 01
<day> = 15
<day> = 31
<day> = 00
<day> = 32

<month> = Jan
<month> = Feb
<month> = Mar
<month> = Apr
<month> = May
<month> = Jun
<month> = Jul
<month> = Aug
<month> = Sep
<month> = Oct
<month> = Nov
<month> = Dec

<year> = <int min=2020 max=2035>
<year> = 1970
<year> = 2000
<year> = 2038
<year> = 9999
<year> = 0

<short_year> = <int min=20 max=99>
<short_year> = 00
<short_year> = 70

<time> = <int min=0 max=23>:<int min=0 max=59>:<int min=0 max=59>
<time> = 00:00:00
<time> = 23:59:59
<time> = 12:00:00
<time> = 25:61:61

# =============================================================================
# Max-Age (RFC 6265bis §5.2.2 — delta-seconds)
# =============================================================================
<max_age_value> = <int min=0 max=31536000>
<max_age_value> = 0
<max_age_value> = -1
<max_age_value> = 1
<max_age_value> = 3600
<max_age_value> = 86400
<max_age_value> = 604800
<max_age_value> = 2592000
<max_age_value> = 31536000
<max_age_value> = 63072000
<max_age_value> = 2147483647
<max_age_value> = -2147483648
<max_age_value> = 99999999999

# =============================================================================
# Domain (RFC 6265bis §5.2.3)
# =============================================================================
<domain_value> = <string min=3 max=12 charset=lower>.<tld>
<domain_value> = .<string min=3 max=12 charset=lower>.<tld>
<domain_value> = <string min=3 max=8 charset=lower>.<string min=3 max=8 charset=lower>.<tld>
<domain_value> = .<string min=3 max=8 charset=lower>.<string min=3 max=8 charset=lower>.<tld>
<domain_value> = localhost
<domain_value> = .localhost
<domain_value> = example.com
<domain_value> = .example.com

# Edge cases
<domain_value> = .<tld>
<domain_value> = .
<domain_value> =
<domain_value> = <string min=3 max=8 charset=lower>.<string min=3 max=8 charset=lower>.<string min=3 max=8 charset=lower>.<tld>
<domain_value> = <int min=1 max=255>.<int min=0 max=255>.<int min=0 max=255>.<int min=0 max=255>

<tld> = com
<tld> = net
<tld> = org
<tld> = io
<tld> = dev
<tld> = co.uk
<tld> = co.jp
<tld> = <string min=2 max=6 charset=lower>

# =============================================================================
# Path (RFC 6265bis §5.2.4)
# =============================================================================
<path_value> = /
<path_value> = /<string min=1 max=20 charset=lower>
<path_value> = /<string min=1 max=10 charset=lower>/<string min=1 max=10 charset=lower>
<path_value> = /<string min=1 max=10 charset=lower>/<string min=1 max=10 charset=lower>/<string min=1 max=10 charset=lower>
<path_value> = /api
<path_value> = /api/v1
<path_value> = /admin
<path_value> = /login
<path_value> = /account

# Edge cases
<path_value> =
<path_value> = /..
<path_value> = /../
<path_value> = /.
<path_value> = //
<path_value> = /<string min=1 max=10 charset=lower>;
<path_value> = /<string min=1 max=10 charset=lower>?<string min=1 max=10 charset=lower>=<string min=1 max=10 charset=alphanumeric>

# =============================================================================
# SameSite (RFC 6265bis §5.2.7)
# =============================================================================
<samesite_value> = Strict
<samesite_value> = Lax
<samesite_value> = None

# Edge cases
<samesite_value> = strict
<samesite_value> = lax
<samesite_value> = none
<samesite_value> = STRICT
<samesite_value> = LAX
<samesite_value> = NONE
<samesite_value> = <string min=3 max=12 charset=lower>

# =============================================================================
# Priority (Chrome extension — not RFC but widely used)
# =============================================================================
<priority_value> = High
<priority_value> = Medium
<priority_value> = Low
<priority_value> = high
<priority_value> = medium
<priority_value> = low

# =============================================================================
# Realistic full Set-Cookie patterns (weighted)
# =============================================================================
<set_cookie_header> = [weight=3] sessionid=<string min=32 max=64 charset=hex>; Path=/; HttpOnly; Secure; SameSite=Lax
<set_cookie_header> = [weight=3] csrftoken=<string min=32 max=64 charset=alphanumeric>; Path=/; SameSite=Lax
<set_cookie_header> = [weight=2] __Host-session=<string min=32 max=64 charset=hex>; Path=/; Secure; HttpOnly; SameSite=Strict
<set_cookie_header> = [weight=2] __Secure-token=<string min=32 max=64 charset=alphanumeric>; Path=/; Secure; HttpOnly; SameSite=Strict
<set_cookie_header> = [weight=2] <cookie_name>=<cookie_value>; Max-Age=<int min=3600 max=86400>; Path=/; HttpOnly; Secure
<set_cookie_header> = [weight=2] <cookie_name>=<cookie_value>; Expires=<cookie_date>; Path=/; Domain=<domain_value>; HttpOnly; Secure; SameSite=None; Partitioned
<set_cookie_header> = [weight=1] _ga=GA1.2.<int min=1000000000 max=9999999999>.<int min=1000000000 max=9999999999>; Expires=<cookie_date>; Path=/; Domain=.<string min=5 max=15 charset=lower>.<tld>
<set_cookie_header> = [weight=1] preferences=<url_encoded_value>; Max-Age=31536000; Path=/; SameSite=Lax
<set_cookie_header> = [weight=1] <cookie_name>=deleted; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Max-Age=0; Path=/

# =============================================================================
# Cookie Crumbles / Cookie Chaos patterns (2023-2025 research)
# =============================================================================

# §1-3: Nameless cookie (CVE-2022-2860, CVE-2022-40958)
<set_cookie_header> = [weight=2] =<cookie_value><cookie_attrs>
<set_cookie_header> = [weight=2] =<cookie_value>; Path=/; Secure

# §1-3: Unicode whitespace prefix bypass (Cookie Crumbles 2023)
<prefixed_cookie_name> = <unicode_ws>__Host-<string min=3 max=20 charset=lower>
<prefixed_cookie_name> = <unicode_ws>__Secure-<string min=3 max=20 charset=lower>
<prefixed_cookie_name> = <unicode_ws>__Host-session
<prefixed_cookie_name> = <unicode_ws>__Secure-token

<unicode_ws> = \xc2\x85
<unicode_ws> = \xc2\xa0
<unicode_ws> = \xe2\x80\x80
<unicode_ws> = \xe2\x80\x83
<unicode_ws> = \xe2\x80\x89
<unicode_ws> = \xe3\x80\x80

# §1-3: PHP name normalization (CVE-2022-31629)
<cookie_name> = __Host.<string min=3 max=12 charset=lower>
<cookie_name> = __Secure.<string min=3 max=12 charset=lower>
<cookie_name> = __Host session
<cookie_name> = session.id

# §2-2: Leading-equals stripping (CVE-2023-23934 Werkzeug)
<set_cookie_header> = [weight=2] =__Host-session=<string min=16 max=32 charset=hex>; Path=/; Secure
<set_cookie_header> = [weight=2] =__Secure-token=<string min=16 max=32 charset=hex>; Path=/; Secure

# §2-3: Percent-encoded cookie name (CVE-2022-36032 ReactPHP)
<cookie_name> = %5F%5FHost-<string min=3 max=12 charset=lower>
<cookie_name> = %5F%5FSecure-<string min=3 max=12 charset=lower>
<cookie_name> = %5f%5fHost-session
<cookie_name> = %5F%5FHost-session

# §2-1: Phantom $Version attribute injection (Cookie Chaos 2025)
<set_cookie_header> = [weight=3] $Version=1; <cookie_name>="<string min=8 max=16 charset=alphanumeric>; Path=/evil"; session=<string min=16 max=32 charset=hex>
<set_cookie_header> = [weight=3] $Version=1; <cookie_name>="<string min=8 max=16 charset=alphanumeric>; Domain=.evil.com"; session=<string min=16 max=32 charset=hex>

# §2-1: $Version comma-separated (RFC 2109 — highest yield from S169)
<set_cookie_header> = [weight=4] $Version=1; <cookie_name>="<string min=8 max=16 charset=alphanumeric>"; Path="/", <cookie_name>="<string min=8 max=16 charset=alphanumeric>"; Path="/"
<set_cookie_header> = [weight=3] $Version=1, <cookie_name>=<cookie_value>, <cookie_name>=<cookie_value>
<set_cookie_header> = [weight=3] $Version="1", <cookie_name>="<string min=8 max=16 charset=alphanumeric>", evil="injected"

# §2-1: $Version + quoted semicolons (cookie sandwich / phantom attrs)
<set_cookie_header> = [weight=4] $Version=1; <cookie_name>="val; JSESSIONID=secret"
<set_cookie_header> = [weight=3] $Version=1; <cookie_name>="val; HttpOnly"; session=<string min=16 max=32 charset=hex>
<set_cookie_header> = [weight=3] $Version=1; <cookie_name>="session_data; Path=/evil; Domain=.evil.com"
<set_cookie_header> = [weight=3] $Version=1; <cookie_name>="b"; $Path="/evil"
<set_cookie_header> = [weight=3] $Version=1; <cookie_name>="b"; $Domain=".evil.com"

# §2-1: Quoted value edge cases (havoc-derived CRITICAL patterns)
<cookie_value> = [weight=2] "<string min=5 max=20 charset=alphanumeric>; <cookie_name>=<string min=8 max=16 charset=hex>"
<cookie_value> = [weight=2] "<string min=5 max=20 charset=alphanumeric>; Path=/admin; Domain=.evil.com"

# =============================================================================
# Byte-level attack patterns (null bytes, CRLF, control chars)
# =============================================================================

# CRLF injection in value
<cookie_value> = abc\r\nSet-Cookie: evil=injected
<cookie_value> = abc\r\nX-Injected: true
<cookie_value> = abc%0d%0aSet-Cookie: evil=injected

# Null byte in value
<cookie_value> = abc\x00def
<cookie_value> = <string min=5 max=10 charset=lower>\x00<string min=5 max=10 charset=lower>

# Control chars in name
<cookie_name> = <string min=3 max=8 charset=lower>\x01<string min=3 max=8 charset=lower>
<cookie_name> = <string min=3 max=8 charset=lower>\x7f<string min=3 max=8 charset=lower>

# Backslash escapes in value (RFC 2109)
<cookie_value> = "<string min=5 max=10 charset=alphanumeric>\"def"
<cookie_value> = "\\074script\\076"
<cookie_value> = "val\\;more"

# =============================================================================
# Scope confusion edge cases
# =============================================================================

# Leading dot toggle
<domain_value> = [weight=2] example.com
<domain_value> = [weight=2] .example.com

# Quoted domain (Python strips quotes, Node keeps)
<cookie_attr> = ; Domain="<domain_value>"
<cookie_attr> = ; Path="<path_value>"

# =============================================================================
# Multi-cookie patterns (header-level)
# =============================================================================

# §5-3: Cookie ordering (same name, different values)
<cookie_header> = <cookie_name>=<cookie_value>; <cookie_name>=<string min=8 max=16 charset=hex>
<cookie_header> = session=first; session=second; session=third

# =============================================================================
# RFC 6265/6265bis Compliance Gap Patterns (G1-G15)
# =============================================================================

# --- G1: CTL in cookie value (RFC 6265 §4.1.1 cookie-octet excludes CTL) ---
<cookie_value> = <string min=3 max=8 charset=lower>\x00<string min=3 max=8 charset=lower>
<cookie_value> = <string min=3 max=8 charset=lower>\x01<string min=3 max=8 charset=lower>
<cookie_value> = <string min=3 max=8 charset=lower>\x09<string min=3 max=8 charset=lower>
<cookie_value> = <string min=3 max=8 charset=lower>\x0b<string min=3 max=8 charset=lower>
<cookie_value> = <string min=3 max=8 charset=lower>\x0c<string min=3 max=8 charset=lower>
<cookie_value> = <string min=3 max=8 charset=lower>\x1f<string min=3 max=8 charset=lower>
<cookie_value> = <string min=3 max=8 charset=lower>\x7f<string min=3 max=8 charset=lower>

# --- G2: CTL in attribute values (RFC 6265bis §5.5) ---
<domain_value> = .<string min=3 max=8 charset=lower>\x00.<tld>
<domain_value> = .<string min=3 max=8 charset=lower>\x01.<tld>
<path_value> = /<string min=3 max=8 charset=lower>\x00<string min=3 max=8 charset=lower>
<path_value> = /<string min=3 max=8 charset=lower>\x7f<string min=3 max=8 charset=lower>

# --- G3: Name+value length boundary (RFC 6265bis §5.6: >4096 SHOULD reject) ---
<set_cookie_header> = [weight=2] <string min=4090 max=4090 charset=lower>=val; Path=/
<set_cookie_header> = [weight=2] s=<string min=4093 max=4093 charset=alphanumeric>; Path=/
<set_cookie_header> = [weight=2] <string min=4092 max=4092 charset=lower>=val; Path=/

# --- G4: Attr-value length boundary (RFC 6265bis §5.6: >1024 SHOULD reject) ---
<domain_value> = .<string min=1020 max=1020 charset=lower>.com
<domain_value> = .<string min=1022 max=1022 charset=lower>.com
<path_value> = /<string min=1023 max=1023 charset=lower>
<path_value> = /<string min=1025 max=1025 charset=lower>

# --- G5: Non-standard Max-Age formats (RFC 6265 §5.2.2: digits only) ---
<max_age_value> = 0x0E10
<max_age_value> = 03600
<max_age_value> = 3600.5
<max_age_value> =  3600
<max_age_value> = +3600
<max_age_value> = 3,600
<max_age_value> = 36e2

# --- G6: Expires delimiter confusion (RFC 6265 §5.1.1) ---
<cookie_date> = Thu 01-Jan-2026 00:00:00 GMT
<cookie_date> = Thu\t01\tJan\t2026\t00:00:00\tGMT
<cookie_date> = Thursday, 01-Jan-26 00:00:00 GMT
<cookie_date> = 01 Jan 2026 00:00:00 GMT
<cookie_date> = Thu, 01 Jan 2026 00:00:00 +0000
<cookie_date> = Thu, 01 Jan 2026 00:00:00 UTC
<cookie_date> = Thu, 01 Jan 2026 00:00:00

# --- G7: __Host- with empty Domain (RFC 6265bis §5.5) ---
<set_cookie_header> = [weight=2] __Host-<string min=3 max=12 charset=lower>=<cookie_value>; Secure; Path=/; Domain=
<set_cookie_header> = [weight=2] __Host-<string min=3 max=12 charset=lower>=<cookie_value>; Secure; Path=/; Domain=""
<set_cookie_header> = [weight=1] __Host-<string min=3 max=12 charset=lower>=<cookie_value>; Secure; Path=/; Domain=

# --- G8: Non-standard whitespace around attribute separators ---
<cookie_attr> = ;\tPath=<path_value>
<cookie_attr> = ;\tSecure
<cookie_attr> = ;\tHttpOnly
<cookie_attr> = ;\r\n Path=<path_value>
<cookie_attr> = ; Path\t=\t<path_value>
<cookie_attr> = ;\x0bSecure
<cookie_attr> = ;\x0cHttpOnly

# --- G9: Extension attributes with special characters ---
<cookie_attr> = ; X-Custom=val;ue
<cookie_attr> = ; X-Test="<string min=3 max=12 charset=alphanumeric>"
<cookie_attr> = ; Priority=Critical
<cookie_attr> = ; X-Foo=a=b=c
<cookie_attr> = ; X-Evil=val\tmore

# --- G10: Duplicate cookie names with different paths ---
<cookie_header> = <cookie_name>=admin; <cookie_name>=guest
<cookie_header> = session=<string min=8 max=16 charset=hex>; session=<string min=8 max=16 charset=hex>; session=<string min=8 max=16 charset=hex>

# --- G11: Max-Age 400-day cap boundary (RFC 6265bis) ---
<max_age_value> = 34559999
<max_age_value> = 34560000
<max_age_value> = 34560001
<max_age_value> = 315360000

# --- G12: SameSite without value / empty value ---
<cookie_attr> = ; SameSite
<cookie_attr> = ; SameSite=

# --- G13: __Secure- without Secure flag ---
<set_cookie_header> = [weight=2] __Secure-<string min=3 max=12 charset=lower>=<cookie_value>; Path=/; HttpOnly

# --- G14: Conflicting Expires + Max-Age (far future Expires, Max-Age=0) ---
<set_cookie_header> = [weight=2] <cookie_name>=<cookie_value>; Expires=Fri, 31 Dec 2099 23:59:59 GMT; Max-Age=0; Path=/

# --- G15: RFC 2109 comma-chained cookies ---
<set_cookie_header> = [weight=3] $Version=1; <cookie_name>="<string min=5 max=12 charset=alphanumeric>", <cookie_name>="<string min=5 max=12 charset=alphanumeric>", <cookie_name>="<string min=5 max=12 charset=alphanumeric>"
