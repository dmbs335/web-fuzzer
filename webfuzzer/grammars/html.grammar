# =============================================================================
# HTML Grammar — WHATWG HTML Living Standard based
# Covers: all element categories, deprecated/obsolete elements,
#         void elements, raw text elements, SVG/MathML integration,
#         all global & element-specific attributes, ARIA, event handlers
# =============================================================================

!root <document>
!max_depth 14
!import ecmascript

# =============================================================================
# Document structure
# =============================================================================
<document> = <doctype><nl><html_elem>
<document> = <html_elem>
<document> = <bom><doctype><nl><html_elem>

<bom> = \xEF\xBB\xBF

<doctype> = <lt>!DOCTYPE html<gt>
<doctype> = <lt>!doctype html<gt>
<doctype> = <lt>!DOCTYPE html SYSTEM "about:legacy-compat"<gt>
<doctype> = <lt>!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN"<gt>
<doctype> = <lt>!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN"<gt>
<doctype> = <lt>!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Frameset//EN"<gt>
<doctype> = <lt>!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd"<gt>
<doctype> = <lt>!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"<gt>

<html_elem> = <lt>html<gt><nl><head_elem><nl><body_elem><nl><lt>/html<gt>
<html_elem> = <lt>html <html_attrs><gt><nl><head_elem><nl><body_elem><nl><lt>/html<gt>

<html_attrs> = lang=<quot><lang_tag><quot>
<html_attrs> = lang=<quot><lang_tag><quot> dir=<quot><dir_val><quot>
<html_attrs> = xmlns=<quot>http://www.w3.org/1999/xhtml<quot>
<html_attrs> = manifest=<quot><url><quot>
<html_attrs> = <global_attrs>

<lang_tag> = en
<lang_tag> = en-US
<lang_tag> = ko
<lang_tag> = ko-KR
<lang_tag> = ja
<lang_tag> = zh-CN
<lang_tag> = zh-TW
<lang_tag> = de
<lang_tag> = fr
<lang_tag> = ar
<lang_tag> = he
<lang_tag> = <string min=2 max=5 charset=lower>
<lang_tag> = <string min=2 max=3 charset=lower>-<string min=2 max=3 charset=upper>

<dir_val> = ltr
<dir_val> = rtl
<dir_val> = auto

# =============================================================================
# Head element — metadata content
# =============================================================================
<head_elem> = <lt>head<gt><nl><head_children><nl><lt>/head<gt>

<head_children> = <meta_charset><nl><title_elem>
<head_children> = <meta_charset><nl><title_elem><nl><head_rest>
<head_children> = <title_elem><nl><head_rest>

<head_rest> = <head_child>
<head_rest> = <head_child><nl><head_rest>

<head_child> = <meta_elem>
<head_child> = <link_elem>
<head_child> = <style_elem>
<head_child> = <script_elem>
<head_child> = <noscript_head>
<head_child> = <base_elem>
<head_child> = <template_elem>
<head_child> = <html_comment>

<title_elem> = <lt>title<gt><text><lt>/title<gt>

# --- base ---
<base_elem> = <lt>base href=<quot><url><quot><gt>
<base_elem> = <lt>base target=<quot><target_val><quot><gt>
<base_elem> = <lt>base href=<quot><url><quot> target=<quot><target_val><quot><gt>

<target_val> = _self
<target_val> = _blank
<target_val> = _parent
<target_val> = _top
<target_val> = <identifier>

# --- meta (comprehensive) ---
<meta_charset> = <lt>meta charset=<quot><charset_val><quot><gt>
<meta_charset> = <lt>meta http-equiv=<quot>Content-Type<quot> content=<quot>text/html; charset=<charset_val><quot><gt>

<charset_val> = UTF-8
<charset_val> = utf-8
<charset_val> = ISO-8859-1
<charset_val> = windows-1252
<charset_val> = Shift_JIS
<charset_val> = EUC-KR
<charset_val> = GB2312
<charset_val> = Big5
<charset_val> = <string min=3 max=15>

<meta_elem> = <lt>meta name=<quot><meta_name_val><quot> content=<quot><text><quot><gt>
<meta_elem> = <lt>meta http-equiv=<quot><http_equiv_val><quot> content=<quot><meta_content><quot><gt>
<meta_elem> = <lt>meta property=<quot><meta_property_val><quot> content=<quot><text><quot><gt>
<meta_elem> = <lt>meta name=<quot>referrer<quot> content=<quot><referrer_policy><quot><gt>
<meta_elem> = <lt>meta name=<quot>color-scheme<quot> content=<quot><color_scheme><quot><gt>
<meta_elem> = <lt>meta name=<quot>theme-color<quot> content=<quot><css_color><quot><gt>
<meta_elem> = <lt>meta name=<quot>viewport<quot> content=<quot><viewport_content><quot><gt>

<meta_name_val> = description
<meta_name_val> = keywords
<meta_name_val> = author
<meta_name_val> = generator
<meta_name_val> = robots
<meta_name_val> = googlebot
<meta_name_val> = application-name
<meta_name_val> = creator
<meta_name_val> = publisher
<meta_name_val> = rating
<meta_name_val> = format-detection
<meta_name_val> = <string min=3 max=25>

<http_equiv_val> = Content-Type
<http_equiv_val> = Content-Security-Policy
<http_equiv_val> = X-UA-Compatible
<http_equiv_val> = refresh
<http_equiv_val> = default-style
<http_equiv_val> = content-language
<http_equiv_val> = X-Content-Type-Options
<http_equiv_val> = X-Frame-Options
<http_equiv_val> = X-XSS-Protection
<http_equiv_val> = X-DNS-Prefetch-Control
<http_equiv_val> = Set-Cookie
<http_equiv_val> = <string min=5 max=25>

<meta_content> = <text>
<meta_content> = <int min=0 max=3600>;url=<url>
<meta_content> = text/html; charset=<charset_val>
<meta_content> = IE=edge

<meta_property_val> = og:title
<meta_property_val> = og:type
<meta_property_val> = og:url
<meta_property_val> = og:image
<meta_property_val> = og:description
<meta_property_val> = og:site_name
<meta_property_val> = og:locale
<meta_property_val> = twitter:card
<meta_property_val> = twitter:site
<meta_property_val> = twitter:creator
<meta_property_val> = fb:app_id
<meta_property_val> = article:published_time

<referrer_policy> = no-referrer
<referrer_policy> = no-referrer-when-downgrade
<referrer_policy> = origin
<referrer_policy> = origin-when-cross-origin
<referrer_policy> = same-origin
<referrer_policy> = strict-origin
<referrer_policy> = strict-origin-when-cross-origin
<referrer_policy> = unsafe-url

<color_scheme> = light
<color_scheme> = dark
<color_scheme> = light dark
<color_scheme> = only light

<viewport_content> = width=device-width, initial-scale=1
<viewport_content> = width=device-width, initial-scale=1, maximum-scale=1
<viewport_content> = width=<int min=200 max=2000>, initial-scale=<float min=0.1 max=10.0 precision=1>
<viewport_content> = width=device-width, initial-scale=1, user-scalable=no
<viewport_content> = width=device-width, shrink-to-fit=no

# --- link (comprehensive) ---
<link_elem> = <lt>link rel=<quot><link_rel_val><quot> href=<quot><url><quot><gt>
<link_elem> = <lt>link rel=<quot>stylesheet<quot> href=<quot><url><quot> media=<quot><media_query><quot><gt>
<link_elem> = <lt>link rel=<quot>stylesheet<quot> href=<quot><url><quot> integrity=<quot><sri_hash><quot> crossorigin=<quot><crossorigin_val><quot><gt>
<link_elem> = <lt>link rel=<quot>preload<quot> as=<quot><preload_as><quot> href=<quot><url><quot><gt>
<link_elem> = <lt>link rel=<quot>preconnect<quot> href=<quot><url><quot> crossorigin<gt>
<link_elem> = <lt>link rel=<quot>modulepreload<quot> href=<quot><url><quot><gt>
<link_elem> = <lt>link rel=<quot>icon<quot> type=<quot><mime_type><quot> sizes=<quot><icon_sizes><quot> href=<quot><url><quot><gt>
<link_elem> = <lt>link rel=<quot>apple-touch-icon<quot> sizes=<quot><icon_sizes><quot> href=<quot><url><quot><gt>
<link_elem> = <lt>link rel=<quot>manifest<quot> href=<quot><url><quot><gt>
<link_elem> = <lt>link rel=<quot>alternate<quot> type=<quot>application/rss+xml<quot> href=<quot><url><quot><gt>
<link_elem> = <lt>link rel=<quot>alternate<quot> hreflang=<quot><lang_tag><quot> href=<quot><url><quot><gt>
<link_elem> = <lt>link rel=<quot>canonical<quot> href=<quot><url><quot><gt>
<link_elem> = <lt>link rel=<quot>dns-prefetch<quot> href=<quot><url><quot><gt>
<link_elem> = <lt>link rel=<quot>pingback<quot> href=<quot><url><quot><gt>

<link_rel_val> = stylesheet
<link_rel_val> = icon
<link_rel_val> = shortcut icon
<link_rel_val> = preload
<link_rel_val> = preconnect
<link_rel_val> = prefetch
<link_rel_val> = prerender
<link_rel_val> = modulepreload
<link_rel_val> = canonical
<link_rel_val> = alternate
<link_rel_val> = author
<link_rel_val> = help
<link_rel_val> = license
<link_rel_val> = next
<link_rel_val> = prev
<link_rel_val> = search
<link_rel_val> = dns-prefetch
<link_rel_val> = manifest
<link_rel_val> = apple-touch-icon
<link_rel_val> = import
<link_rel_val> = pingback
<link_rel_val> = <string min=3 max=20 charset=lower>

<preload_as> = script
<preload_as> = style
<preload_as> = image
<preload_as> = font
<preload_as> = fetch
<preload_as> = document
<preload_as> = audio
<preload_as> = video
<preload_as> = track
<preload_as> = worker

<crossorigin_val> = anonymous
<crossorigin_val> = use-credentials
<crossorigin_val> =

<sri_hash> = sha256-<string min=44 max=44 charset=alphanumeric>
<sri_hash> = sha384-<string min=64 max=64 charset=alphanumeric>
<sri_hash> = sha512-<string min=88 max=88 charset=alphanumeric>

<icon_sizes> = 16x16
<icon_sizes> = 32x32
<icon_sizes> = 48x48
<icon_sizes> = 64x64
<icon_sizes> = 128x128
<icon_sizes> = 180x180
<icon_sizes> = 192x192
<icon_sizes> = 512x512
<icon_sizes> = any

<media_query> = all
<media_query> = screen
<media_query> = print
<media_query> = (prefers-color-scheme: dark)
<media_query> = (max-width: <int min=200 max=2000>px)
<media_query> = screen and (min-width: <int min=200 max=2000>px)
<media_query> = not print

# --- style ---
<style_elem> = <lt>style<gt><nl><css_content><nl><lt>/style<gt>
<style_elem> = <lt>style media=<quot><media_query><quot><gt><nl><css_content><nl><lt>/style<gt>
<style_elem> = <lt>style nonce=<quot><nonce_val><quot><gt><nl><css_content><nl><lt>/style<gt>
<style_elem> = <lt>style type=<quot>text/css<quot><gt><nl><css_content><nl><lt>/style<gt>

<nonce_val> = <string min=16 max=32 charset=alphanumeric>

# --- noscript ---
<noscript_head> = <lt>noscript<gt><meta_elem><lt>/noscript<gt>
<noscript_head> = <lt>noscript<gt><link_elem><lt>/noscript<gt>
<noscript_head> = <lt>noscript<gt><style_elem><lt>/noscript<gt>

# =============================================================================
# Body element
# =============================================================================
<body_elem> = <lt>body<gt><nl><flow_content><nl><lt>/body<gt>
<body_elem> = <lt>body <body_attrs><gt><nl><flow_content><nl><lt>/body<gt>

<body_attrs> = <global_attrs>
<body_attrs> = <event_handler_attr>
<body_attrs> = <body_event_attr>
<body_attrs> = <global_attrs> <body_event_attr>

# body-specific event handlers (Window events)
<body_event_attr> = onbeforeunload=<quot><js_expr><quot>
<body_event_attr> = onhashchange=<quot><js_expr><quot>
<body_event_attr> = onlanguagechange=<quot><js_expr><quot>
<body_event_attr> = onmessage=<quot><js_expr><quot>
<body_event_attr> = onmessageerror=<quot><js_expr><quot>
<body_event_attr> = onoffline=<quot><js_expr><quot>
<body_event_attr> = ononline=<quot><js_expr><quot>
<body_event_attr> = onpagehide=<quot><js_expr><quot>
<body_event_attr> = onpageshow=<quot><js_expr><quot>
<body_event_attr> = onpopstate=<quot><js_expr><quot>
<body_event_attr> = onrejectionhandled=<quot><js_expr><quot>
<body_event_attr> = onstorage=<quot><js_expr><quot>
<body_event_attr> = onunhandledrejection=<quot><js_expr><quot>
<body_event_attr> = onunload=<quot><js_expr><quot>

# =============================================================================
# Flow content — all element categories
# =============================================================================
<flow_content> = <element>
<flow_content> = <element><nl><flow_content>
<flow_content> = <text>
<flow_content> = <html_comment>

<element> = <sectioning_elem>
<element> = <heading_content>
<element> = <phrasing_elem>
<element> = <embedded_elem>
<element> = <interactive_elem>
<element> = <grouping_elem>
<element> = <tabular_elem>
<element> = <form_elem>
<element> = <scripting_elem>
<element> = <deprecated_elem>
<element> = <svg_elem>
<element> = <mathml_elem>
<element> = <custom_elem>
<element> = <web_component_elem>

# =============================================================================
# Sectioning content
# =============================================================================
<sectioning_elem> = <article_elem>
<sectioning_elem> = <aside_elem>
<sectioning_elem> = <nav_elem>
<sectioning_elem> = <section_elem>
<sectioning_elem> = <header_elem>
<sectioning_elem> = <footer_elem>
<sectioning_elem> = <main_elem>
<sectioning_elem> = <address_elem>

<article_elem> = <lt>article <global_attrs><gt><nl><flow_content><nl><lt>/article<gt>
<article_elem> = <lt>article<gt><nl><flow_content><nl><lt>/article<gt>

<aside_elem> = <lt>aside <global_attrs><gt><nl><flow_content><nl><lt>/aside<gt>
<aside_elem> = <lt>aside<gt><nl><flow_content><nl><lt>/aside<gt>

<nav_elem> = <lt>nav <global_attrs><gt><nl><flow_content><nl><lt>/nav<gt>
<nav_elem> = <lt>nav<gt><nl><flow_content><nl><lt>/nav<gt>

<section_elem> = <lt>section <global_attrs><gt><nl><flow_content><nl><lt>/section<gt>
<section_elem> = <lt>section<gt><nl><flow_content><nl><lt>/section<gt>

<header_elem> = <lt>header <global_attrs><gt><nl><flow_content><nl><lt>/header<gt>
<footer_elem> = <lt>footer <global_attrs><gt><nl><flow_content><nl><lt>/footer<gt>
<main_elem> = <lt>main <global_attrs><gt><nl><flow_content><nl><lt>/main<gt>
<main_elem> = <lt>main<gt><nl><flow_content><nl><lt>/main<gt>
<address_elem> = <lt>address<gt><phrasing_content><lt>/address<gt>

# =============================================================================
# Heading content
# =============================================================================
<heading_content> = <lt><heading_tag> <global_attrs><gt><phrasing_content><lt>/<heading_tag><gt>
<heading_content> = <lt><heading_tag><gt><phrasing_content><lt>/<heading_tag><gt>
<heading_content> = <hgroup_elem>

<heading_tag> = h1
<heading_tag> = h2
<heading_tag> = h3
<heading_tag> = h4
<heading_tag> = h5
<heading_tag> = h6

<hgroup_elem> = <lt>hgroup<gt><nl><heading_content><nl><lt>/hgroup<gt>

# =============================================================================
# Grouping content
# =============================================================================
<grouping_elem> = <p_elem>
<grouping_elem> = <div_elem>
<grouping_elem> = <pre_elem>
<grouping_elem> = <blockquote_elem>
<grouping_elem> = <hr_elem>
<grouping_elem> = <ol_elem>
<grouping_elem> = <ul_elem>
<grouping_elem> = <menu_elem>
<grouping_elem> = <dl_elem>
<grouping_elem> = <figure_elem>
<grouping_elem> = <details_elem>
<grouping_elem> = <dialog_elem>
<grouping_elem> = <search_elem>

<p_elem> = <lt>p <global_attrs><gt><phrasing_content><lt>/p<gt>
<p_elem> = <lt>p<gt><phrasing_content><lt>/p<gt>

<div_elem> = <lt>div <global_attrs><gt><nl><flow_content><nl><lt>/div<gt>
<div_elem> = <lt>div<gt><nl><flow_content><nl><lt>/div<gt>

<pre_elem> = <lt>pre<gt><text><lt>/pre<gt>
<pre_elem> = <lt>pre <global_attrs><gt><lt>code<gt><text><lt>/code<gt><lt>/pre<gt>

<blockquote_elem> = <lt>blockquote cite=<quot><url><quot><gt><nl><flow_content><nl><lt>/blockquote<gt>
<blockquote_elem> = <lt>blockquote<gt><nl><flow_content><nl><lt>/blockquote<gt>

<hr_elem> = <lt>hr<gt>
<hr_elem> = <lt>hr <global_attrs><gt>
<hr_elem> = <lt>hr/<gt>

<ol_elem> = <lt>ol <ol_attrs><gt><nl><li_items><nl><lt>/ol<gt>
<ol_elem> = <lt>ol<gt><nl><li_items><nl><lt>/ol<gt>

<ol_attrs> = start=<quot><int min=-100 max=100><quot>
<ol_attrs> = reversed
<ol_attrs> = type=<quot><ol_type_val><quot>
<ol_attrs> = start=<quot><int min=0 max=100><quot> reversed type=<quot><ol_type_val><quot>

<ol_type_val> = 1
<ol_type_val> = a
<ol_type_val> = A
<ol_type_val> = i
<ol_type_val> = I

<ul_elem> = <lt>ul <global_attrs><gt><nl><li_items><nl><lt>/ul<gt>
<ul_elem> = <lt>ul<gt><nl><li_items><nl><lt>/ul<gt>

<menu_elem> = <lt>menu<gt><nl><li_items><nl><lt>/menu<gt>

<li_items> = <li_item>
<li_items> = <li_item><nl><li_items>

<li_item> = <lt>li<gt><phrasing_content><lt>/li<gt>
<li_item> = <lt>li <global_attrs><gt><flow_content><lt>/li<gt>
<li_item> = <lt>li value=<quot><int min=-100 max=100><quot><gt><phrasing_content><lt>/li<gt>

<dl_elem> = <lt>dl<gt><nl><dl_items><nl><lt>/dl<gt>
<dl_items> = <lt>dt<gt><phrasing_content><lt>/dt<gt><nl><lt>dd<gt><flow_content><lt>/dd<gt>
<dl_items> = <lt>dt<gt><phrasing_content><lt>/dt<gt><nl><lt>dd<gt><flow_content><lt>/dd<gt><nl><dl_items>
<dl_items> = <lt>div<gt><nl><lt>dt<gt><phrasing_content><lt>/dt<gt><nl><lt>dd<gt><flow_content><lt>/dd<gt><nl><lt>/div<gt>

<figure_elem> = <lt>figure<gt><nl><element><nl><lt>figcaption<gt><phrasing_content><lt>/figcaption<gt><nl><lt>/figure<gt>
<figure_elem> = <lt>figure<gt><nl><lt>figcaption<gt><phrasing_content><lt>/figcaption<gt><nl><element><nl><lt>/figure<gt>

<details_elem> = <lt>details <details_attrs><gt><nl><lt>summary<gt><phrasing_content><lt>/summary<gt><nl><flow_content><nl><lt>/details<gt>
<details_elem> = <lt>details open<gt><nl><lt>summary<gt><phrasing_content><lt>/summary<gt><nl><flow_content><nl><lt>/details<gt>

<details_attrs> = open
<details_attrs> = name=<quot><identifier><quot>
<details_attrs> = open name=<quot><identifier><quot>

<dialog_elem> = <lt>dialog <dialog_attrs><gt><nl><flow_content><nl><lt>/dialog<gt>
<dialog_attrs> = open
<dialog_attrs> = <global_attrs>

<search_elem> = <lt>search<gt><nl><flow_content><nl><lt>/search<gt>

# =============================================================================
# Phrasing content — inline elements
# =============================================================================
<phrasing_content> = <phrasing_elem>
<phrasing_content> = <text>
<phrasing_content> = <phrasing_elem><phrasing_content>

<phrasing_elem> = <span_elem>
<phrasing_elem> = <a_elem>
<phrasing_elem> = <strong_elem>
<phrasing_elem> = <em_elem>
<phrasing_elem> = <code_elem>
<phrasing_elem> = <br_elem>
<phrasing_elem> = <wbr_elem>
<phrasing_elem> = <text_level_elem>
<phrasing_elem> = <data_elem>
<phrasing_elem> = <time_elem>
<phrasing_elem> = <abbr_elem>
<phrasing_elem> = <bdi_elem>
<phrasing_elem> = <bdo_elem>
<phrasing_elem> = <ruby_elem>
<phrasing_elem> = <output_elem>
<phrasing_elem> = <slot_elem>

<span_elem> = <lt>span <global_attrs><gt><phrasing_content><lt>/span<gt>
<span_elem> = <lt>span<gt><text><lt>/span<gt>

<a_elem> = <lt>a href=<quot><url><quot> <a_attrs><gt><phrasing_content><lt>/a<gt>
<a_elem> = <lt>a href=<quot><url><quot><gt><phrasing_content><lt>/a<gt>
<a_elem> = <lt>a href=<quot>javascript:<js_expr><quot><gt><text><lt>/a<gt>
<a_elem> = <lt>a href=<quot><url><quot> download=<quot><text><quot><gt><text><lt>/a<gt>
<a_elem> = <lt>a href=<quot>mailto:<text>@<text>.<tld><quot><gt><text><lt>/a<gt>
<a_elem> = <lt>a href=<quot>tel:+<int min=1 max=99><int min=1000000 max=9999999><quot><gt><text><lt>/a<gt>
<a_elem> = <lt>a href=<quot>#<identifier><quot><gt><text><lt>/a<gt>
<a_elem> = <lt>a name=<quot><identifier><quot><gt><text><lt>/a<gt>

<a_attrs> = target=<quot><target_val><quot>
<a_attrs> = target=<quot><target_val><quot> rel=<quot><rel_val><quot>
<a_attrs> = rel=<quot><rel_val><quot>
<a_attrs> = hreflang=<quot><lang_tag><quot>
<a_attrs> = type=<quot><mime_type><quot>
<a_attrs> = referrerpolicy=<quot><referrer_policy><quot>
<a_attrs> = ping=<quot><url><quot>
<a_attrs> = download
<a_attrs> = <global_attrs>

<rel_val> = noopener
<rel_val> = noreferrer
<rel_val> = nofollow
<rel_val> = noopener noreferrer
<rel_val> = opener
<rel_val> = external
<rel_val> = bookmark
<rel_val> = tag
<rel_val> = ugc
<rel_val> = sponsored
<rel_val> = <string min=3 max=15 charset=lower>

<strong_elem> = <lt>strong<gt><phrasing_content><lt>/strong<gt>
<em_elem> = <lt>em<gt><phrasing_content><lt>/em<gt>
<code_elem> = <lt>code<gt><text><lt>/code<gt>
<br_elem> = <lt>br<gt>
<br_elem> = <lt>br/<gt>
<wbr_elem> = <lt>wbr<gt>

<text_level_elem> = <lt>b<gt><text><lt>/b<gt>
<text_level_elem> = <lt>i<gt><text><lt>/i<gt>
<text_level_elem> = <lt>u<gt><text><lt>/u<gt>
<text_level_elem> = <lt>s<gt><text><lt>/s<gt>
