# =============================================================================
# Comments and special constructs
# =============================================================================
<html_comment> = <lt>!-- <text> --<gt>
<html_comment> = <lt>!--<text>--<gt>
<html_comment> = <lt>!----<gt>
<html_comment> = <lt>!-- --<gt>

# =============================================================================
# Shared value terminals
# =============================================================================
<js_expr> = alert(1)
<js_expr> = alert(document.domain)
<js_expr> = alert(document.cookie)
<js_expr> = console.log(1)
<js_expr> = <identifier>()
<js_expr> = void(0)
<js_expr> = this.<identifier>
<js_expr> = window.<identifier>
<js_expr> = <string min=3 max=30>

<url> = https://example.com/<path>
<url> = https://<string min=3 max=15 charset=lower>.<tld>/<path>
<url> = http://<string min=3 max=15 charset=lower>.<tld>/<path>
<url> = //<string min=3 max=15 charset=lower>.<tld>/<path>
<url> = /<path>
<url> = <path>
<url> = javascript:void(0)
<url> = javascript:<js_expr>
<url> = data:<mime_type>;base64,<string min=10 max=40 charset=alphanumeric>
<url> = blob:<url>
<url> = about:blank
<url> = about:srcdoc
<url> = #<identifier>
<url> = ?<identifier>=<text>
<url> = <string min=5 max=40>

<data_uri> = data:image/svg+xml,<lt>svg<gt><lt>/svg<gt>
<data_uri> = data:text/html,<text>
<data_uri> = data:text/html;base64,<string min=10 max=40 charset=alphanumeric>
<data_uri> = data:<mime_type>;base64,<string min=10 max=40 charset=alphanumeric>
<data_uri> = data:image/png;base64,<string min=20 max=60 charset=alphanumeric>

<path> = <string min=1 max=15 charset=lower>
<path> = <string min=1 max=10 charset=lower>/<path>
<path> = <string min=1 max=10 charset=lower>.<string min=2 max=5 charset=lower>

<tld> = com
<tld> = net
<tld> = org
<tld> = io
<tld> = dev
<tld> = co.kr
<tld> = co.jp

<mime_type> = text/html
<mime_type> = text/plain
<mime_type> = text/css
<mime_type> = text/javascript
<mime_type> = application/javascript
<mime_type> = application/json
<mime_type> = application/xml
<mime_type> = application/xhtml+xml
<mime_type> = application/pdf
<mime_type> = application/octet-stream
<mime_type> = application/x-shockwave-flash
<mime_type> = image/png
<mime_type> = image/jpeg
<mime_type> = image/gif
<mime_type> = image/svg+xml
<mime_type> = image/webp
<mime_type> = image/avif
<mime_type> = audio/mpeg
<mime_type> = video/mp4
<mime_type> = video/webm
<mime_type> = font/woff2
<mime_type> = multipart/form-data
<mime_type> = <string min=3 max=15 charset=lower>/<string min=3 max=15 charset=lower>

<identifier> = <string min=2 max=12 charset=lower>
<text> = <string min=1 max=30>
<class_list> = <identifier>
<class_list> = <identifier> <class_list>

# --- CSS inline (basic for attributes) ---
<css_inline> = color: <css_color>
<css_inline> = background: <css_color>
<css_inline> = background-image: url(<url>)
<css_inline> = <css_prop>: <css_val>
<css_inline> = <css_inline>; <css_inline>

<css_content> = <css_rule>
<css_content> = <css_rule><nl><css_content>

<css_rule> = <css_selector> { <css_declarations> }
<css_rule> = @import url(<quot><url><quot>);
<css_rule> = @media <media_query> { <css_rule> }
<css_rule> = @font-face { font-family: <quot><text><quot>; src: url(<quot><url><quot>); }
<css_rule> = @keyframes <identifier> { from { <css_declarations> } to { <css_declarations> } }

<css_selector> = <css_simple_selector>
<css_selector> = <css_simple_selector> <css_combinator> <css_simple_selector>

<css_simple_selector> = <identifier>
<css_simple_selector> = .<identifier>
<css_simple_selector> = #<identifier>
<css_simple_selector> = *
<css_simple_selector> = [<identifier>]
<css_simple_selector> = [<identifier>=<quot><text><quot>]
<css_simple_selector> = :<css_pseudo_class>
<css_simple_selector> = ::<css_pseudo_element>

<css_combinator> = <sp>
<css_combinator> = >
<css_combinator> = +
<css_combinator> = ~

<css_pseudo_class> = hover
<css_pseudo_class> = focus
<css_pseudo_class> = active
<css_pseudo_class> = first-child
<css_pseudo_class> = last-child
<css_pseudo_class> = nth-child(<int min=1 max=10>)
<css_pseudo_class> = not(<css_simple_selector>)
<css_pseudo_class> = has(<css_simple_selector>)

<css_pseudo_element> = before
<css_pseudo_element> = after
<css_pseudo_element> = first-line
<css_pseudo_element> = first-letter
<css_pseudo_element> = placeholder
<css_pseudo_element> = selection

<css_declarations> = <css_declaration>
<css_declarations> = <css_declaration>; <css_declarations>

<css_declaration> = <css_prop>: <css_val>
<css_declaration> = <css_prop>: <css_val> !important

<css_color> = red
<css_color> = blue
<css_color> = green
<css_color> = transparent
<css_color> = currentColor
<css_color> = #<hex len=6>
<css_color> = #<hex len=3>
<css_color> = #<hex len=8>
<css_color> = rgb(<int min=0 max=255> <int min=0 max=255> <int min=0 max=255>)
<css_color> = rgba(<int min=0 max=255>, <int min=0 max=255>, <int min=0 max=255>, <float min=0.0 max=1.0 precision=2>)
<css_color> = hsl(<int min=0 max=360> <int min=0 max=100>% <int min=0 max=100>%)
<css_color> = oklch(<float min=0.0 max=1.0 precision=2> <float min=0.0 max=0.4 precision=3> <int min=0 max=360>)
<css_color> = color-mix(in srgb, <css_color> <int min=0 max=100>%, <css_color>)

<css_prop> = width
<css_prop> = height
<css_prop> = min-width
<css_prop> = max-width
<css_prop> = min-height
<css_prop> = max-height
<css_prop> = margin
<css_prop> = padding
<css_prop> = border
<css_prop> = display
<css_prop> = position
<css_prop> = top
<css_prop> = right
<css_prop> = bottom
<css_prop> = left
<css_prop> = float
<css_prop> = clear
<css_prop> = overflow
<css_prop> = z-index
<css_prop> = opacity
<css_prop> = visibility
<css_prop> = font-size
<css_prop> = font-family
<css_prop> = font-weight
<css_prop> = line-height
<css_prop> = text-align
<css_prop> = text-decoration
<css_prop> = transform
<css_prop> = transition
<css_prop> = animation
<css_prop> = flex
<css_prop> = grid-template-columns
<css_prop> = gap
<css_prop> = aspect-ratio
<css_prop> = container-type
<css_prop> = content-visibility

<css_val> = <int min=0 max=1000>px
<css_val> = <int min=0 max=100>%
<css_val> = <float min=0.0 max=10.0 precision=1>em
<css_val> = <float min=0.0 max=100.0 precision=1>rem
<css_val> = <int min=0 max=100>vw
<css_val> = <int min=0 max=100>vh
<css_val> = auto
<css_val> = none
<css_val> = inherit
<css_val> = initial
<css_val> = unset
<css_val> = revert
<css_val> = <css_color>
<css_val> = <text>
