# =============================================================================
# SAML 2.0 Response Grammar — Signature verification differential fuzzing
# Covers: Response envelope, Assertion, Subject/NameID, Conditions,
#         AuthnStatement, AttributeStatement, ds:Signature skeleton,
#         namespace variations, algorithm permutations, edge cases
# =============================================================================

!root <saml_response>
!max_depth 10

# =============================================================================
# Top-level SAML Response
# =============================================================================
<saml_response> = [weight=10] <xml_decl><response_elem>
<saml_response> = [weight=3] <response_elem>
<saml_response> = [weight=1] <xml_decl><doctype_decl><response_elem>

<xml_decl> = <lt>?xml version="1.0" encoding="UTF-8"?<gt><nl>
<xml_decl> = <lt>?xml version="1.0" encoding="utf-8"?<gt><nl>
<xml_decl> = <lt>?xml version="1.0"?<gt><nl>

# --- DOCTYPE variants (for S5/S2 mutation surface) ---
<doctype_decl> = <lt>!DOCTYPE samlp:Response<gt><nl>
<doctype_decl> = <lt>!DOCTYPE samlp:Response [<lt>!ENTITY test "test"<gt>]<gt><nl>
<doctype_decl> = [weight=1] <lt>!DOCTYPE samlp:Response [<lt>!ATTLIST saml:Assertion xmlns:saml CDATA "urn:oasis:names:tc:SAML:2.0:assertion"<gt>]<gt><nl>

# =============================================================================
# Response element (samlp:Response)
# =============================================================================
<response_elem> = <lt>samlp:Response <response_attrs><gt><nl><response_body><nl><lt>/samlp:Response<gt>

<response_attrs> = xmlns:samlp=<quot><samlp_ns><quot> xmlns:saml=<quot><saml_ns><quot> ID=<quot><response_id><quot> Version=<quot>2.0<quot> IssueInstant=<quot><timestamp><quot> Destination=<quot><sp_acs_url><quot>
<response_attrs> = xmlns:samlp=<quot><samlp_ns><quot> xmlns:saml=<quot><saml_ns><quot> ID=<quot><response_id><quot> Version=<quot>2.0<quot> IssueInstant=<quot><timestamp><quot> Destination=<quot><sp_acs_url><quot> InResponseTo=<quot><request_id><quot>

# --- namespace URIs ---
<samlp_ns> = urn:oasis:names:tc:SAML:2.0:protocol
<saml_ns> = urn:oasis:names:tc:SAML:2.0:assertion
<saml_ns> = [weight=1] urn:oasis:names:tc:SAML:2.0:Assertion
<ds_ns> = http://www.w3.org/2000/09/xmldsig#

# --- IDs ---
<response_id> = _<hex_id>
<request_id> = _<hex_id>
<assertion_id> = _<hex_id>
<session_index> = _<hex_id>
<hex_id> = <string min=32 max=32 charset=hex>

# --- timestamps ---
<timestamp> = 2025-06-15T10:30:00Z
<timestamp> = 2025-01-01T00:00:00Z
<timestamp> = <int min=2024 max=2027>-<padded_month>-<padded_day>T<padded_hour>:<padded_min>:00Z
<future_timestamp> = 2030-12-31T23:59:59Z
<future_timestamp> = 2099-01-01T00:00:00Z

<padded_month> = 01
<padded_month> = 06
<padded_month> = 12
<padded_day> = 01
<padded_day> = 15
<padded_day> = 28
<padded_hour> = 00
<padded_hour> = 12
<padded_hour> = 23
<padded_min> = 00
<padded_min> = 30
<padded_min> = 59

# --- SP/IdP URLs ---
<sp_acs_url> = https://sp.example.com/acs
<sp_entity_id> = https://sp.example.com
<idp_entity_id> = https://idp.example.com
<idp_sso_url> = https://idp.example.com/sso

# =============================================================================
# Response body
# =============================================================================
<response_body> = <issuer_elem><nl><status_elem><nl><assertion_elem>
<response_body> = [weight=5] <issuer_elem><nl><status_elem><nl><assertion_elem_signed>
<response_body> = [weight=3] <issuer_elem><nl><status_elem><nl><ds_signature><nl><assertion_elem>
<response_body> = [weight=1] <issuer_elem><nl><status_elem><nl><assertion_elem><nl><assertion_elem>
<response_body> = [weight=1] <issuer_elem><nl><status_elem><nl><assertion_elem_signed><nl><assertion_elem>

# =============================================================================
# Issuer
# =============================================================================
<issuer_elem> = <lt>saml:Issuer<gt><issuer_value><lt>/saml:Issuer<gt>

<issuer_value> = https://idp.example.com
<issuer_value> = https://idp.fuzzer.local
<issuer_value> = [weight=1] <string min=5 max=25 charset=lower>

# =============================================================================
# Status
# =============================================================================
<status_elem> = <lt>samlp:Status<gt><lt>samlp:StatusCode Value=<quot><status_code><quot>/<gt><lt>/samlp:Status<gt>

<status_code> = urn:oasis:names:tc:SAML:2.0:status:Success
<status_code> = [weight=1] urn:oasis:names:tc:SAML:2.0:status:Responder
<status_code> = [weight=1] urn:oasis:names:tc:SAML:2.0:status:Requester

# =============================================================================
# Assertion (saml:Assertion)
# =============================================================================
<assertion_elem> = <lt>saml:Assertion xmlns:saml=<quot><saml_ns><quot> Version=<quot>2.0<quot> ID=<quot><assertion_id><quot> IssueInstant=<quot><timestamp><quot><gt><nl><assertion_body><nl><lt>/saml:Assertion<gt>

<assertion_elem_signed> = <lt>saml:Assertion xmlns:saml=<quot><saml_ns><quot> Version=<quot>2.0<quot> ID=<quot><assertion_id><quot> IssueInstant=<quot><timestamp><quot><gt><nl><assertion_body_signed><nl><lt>/saml:Assertion<gt>

<assertion_body> = <issuer_elem><nl><subject_elem><nl><conditions_elem><nl><authn_statement>
<assertion_body> = <issuer_elem><nl><subject_elem><nl><conditions_elem><nl><authn_statement><nl><attribute_statement>

<assertion_body_signed> = <issuer_elem><nl><ds_signature><nl><subject_elem><nl><conditions_elem><nl><authn_statement>
<assertion_body_signed> = <issuer_elem><nl><ds_signature><nl><subject_elem><nl><conditions_elem><nl><authn_statement><nl><attribute_statement>

# =============================================================================
# Subject (NameID)
# =============================================================================
<subject_elem> = <lt>saml:Subject<gt><nl><name_id_elem><nl><subject_confirmation><nl><lt>/saml:Subject<gt>

<name_id_elem> = <lt>saml:NameID Format=<quot><nameid_format><quot><gt><nameid_value><lt>/saml:NameID<gt>
<name_id_elem> = <lt>saml:NameID Format=<quot><nameid_format><quot> SPNameQualifier=<quot><sp_entity_id><quot><gt><nameid_value><lt>/saml:NameID<gt>
<name_id_elem> = [weight=1] <lt>saml:NameID<gt><nameid_value><lt>/saml:NameID<gt>

<nameid_format> = urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
<nameid_format> = urn:oasis:names:tc:SAML:2.0:nameid-format:persistent
<nameid_format> = urn:oasis:names:tc:SAML:2.0:nameid-format:transient
<nameid_format> = urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified

<nameid_value> = admin@example.com
<nameid_value> = user@example.com
<nameid_value> = admin
<nameid_value> = test-user
<nameid_value> = <string min=3 max=15 charset=lower>@example.com
<nameid_value> = [weight=1] <string min=3 max=20 charset=lower>

<subject_confirmation> = <lt>saml:SubjectConfirmation Method=<quot>urn:oasis:names:tc:SAML:2.0:cm:bearer<quot><gt><lt>saml:SubjectConfirmationData NotOnOrAfter=<quot><future_timestamp><quot> Recipient=<quot><sp_acs_url><quot>/<gt><lt>/saml:SubjectConfirmation<gt>
<subject_confirmation> = <lt>saml:SubjectConfirmation Method=<quot>urn:oasis:names:tc:SAML:2.0:cm:bearer<quot><gt><lt>saml:SubjectConfirmationData NotOnOrAfter=<quot><future_timestamp><quot> Recipient=<quot><sp_acs_url><quot> InResponseTo=<quot><request_id><quot>/<gt><lt>/saml:SubjectConfirmation<gt>

# =============================================================================
# Conditions
# =============================================================================
<conditions_elem> = <lt>saml:Conditions NotBefore=<quot><timestamp><quot> NotOnOrAfter=<quot><future_timestamp><quot><gt><nl><audience_restriction><nl><lt>/saml:Conditions<gt>
<conditions_elem> = [weight=1] <lt>saml:Conditions<gt><nl><audience_restriction><nl><lt>/saml:Conditions<gt>

<audience_restriction> = <lt>saml:AudienceRestriction<gt><lt>saml:Audience<gt><audience_value><lt>/saml:Audience<gt><lt>/saml:AudienceRestriction<gt>

<audience_value> = https://sp.example.com
<audience_value> = [weight=1] <string min=5 max=30 charset=lower>

# =============================================================================
# AuthnStatement
# =============================================================================
<authn_statement> = <lt>saml:AuthnStatement AuthnInstant=<quot><timestamp><quot> SessionIndex=<quot><session_index><quot><gt><nl><authn_context><nl><lt>/saml:AuthnStatement<gt>

<authn_context> = <lt>saml:AuthnContext<gt><lt>saml:AuthnContextClassRef<gt><authn_class><lt>/saml:AuthnContextClassRef<gt><lt>/saml:AuthnContext<gt>

<authn_class> = urn:oasis:names:tc:SAML:2.0:ac:classes:PasswordProtectedTransport
<authn_class> = urn:oasis:names:tc:SAML:2.0:ac:classes:Password
<authn_class> = urn:oasis:names:tc:SAML:2.0:ac:classes:X509

# =============================================================================
# AttributeStatement
# =============================================================================
<attribute_statement> = <lt>saml:AttributeStatement<gt><nl><saml_attr_list><nl><lt>/saml:AttributeStatement<gt>

<saml_attr_list> = <saml_attribute>
<saml_attr_list> = <saml_attribute><nl><saml_attr_list>

<saml_attribute> = <lt>saml:Attribute Name=<quot><attr_name><quot> NameFormat=<quot>urn:oasis:names:tc:SAML:2.0:attrname-format:basic<quot><gt><nl><attr_values><nl><lt>/saml:Attribute<gt>
<saml_attribute> = <lt>saml:Attribute Name=<quot><attr_name><quot><gt><nl><attr_values><nl><lt>/saml:Attribute<gt>

<attr_values> = <lt>saml:AttributeValue<gt><attr_value><lt>/saml:AttributeValue<gt>
<attr_values> = <lt>saml:AttributeValue<gt><attr_value><lt>/saml:AttributeValue<gt><nl><attr_values>

<attr_name> = role
<attr_name> = email
<attr_name> = groups
<attr_name> = displayName
<attr_name> = firstName
<attr_name> = lastName
<attr_name> = [weight=1] <string min=3 max=15 charset=lower>

<attr_value> = admin
<attr_value> = user
<attr_value> = member
<attr_value> = <string min=3 max=15 charset=lower>
<attr_value> = <string min=3 max=12 charset=lower>@example.com

# =============================================================================
# ds:Signature skeleton
# The grammar produces structural placeholders. Actual valid signatures
# come from the seed generator; the mutator applies targeted modifications.
# =============================================================================
<ds_signature> = <lt>ds:Signature xmlns:ds=<quot><ds_ns><quot><gt><nl><signed_info><nl><signature_value><nl><key_info><nl><lt>/ds:Signature<gt>

<signed_info> = <lt>ds:SignedInfo<gt><nl><c14n_method><nl><sig_method><nl><ds_reference><nl><lt>/ds:SignedInfo<gt>

<c14n_method> = <lt>ds:CanonicalizationMethod Algorithm=<quot><c14n_algorithm><quot>/<gt>

<sig_method> = <lt>ds:SignatureMethod Algorithm=<quot><sig_algorithm><quot>/<gt>

<ds_reference> = <lt>ds:Reference URI=<quot>#<assertion_id><quot><gt><nl><transforms><nl><digest_method><nl><digest_value><nl><lt>/ds:Reference<gt>
<ds_reference> = [weight=1] <lt>ds:Reference URI=<quot><quot><gt><nl><transforms><nl><digest_method><nl><digest_value><nl><lt>/ds:Reference<gt>

<transforms> = <lt>ds:Transforms<gt><nl><transform_enveloped><nl><transform_c14n><nl><lt>/ds:Transforms<gt>

<transform_enveloped> = <lt>ds:Transform Algorithm=<quot>http://www.w3.org/2000/09/xmldsig#enveloped-signature<quot>/<gt>
<transform_c14n> = <lt>ds:Transform Algorithm=<quot><c14n_algorithm><quot>/<gt>

<digest_method> = <lt>ds:DigestMethod Algorithm=<quot><digest_algorithm><quot>/<gt>

<digest_value> = <lt>ds:DigestValue<gt><base64_block><lt>/ds:DigestValue<gt>
<signature_value> = <lt>ds:SignatureValue<gt><base64_block><lt>/ds:SignatureValue<gt>

<key_info> = <lt>ds:KeyInfo<gt><nl><lt>ds:X509Data<gt><lt>ds:X509Certificate<gt><base64_block><lt>/ds:X509Certificate<gt><lt>/ds:X509Data<gt><nl><lt>/ds:KeyInfo<gt>
<key_info> = [weight=1] <lt>ds:KeyInfo<gt><nl><lt>ds:KeyValue<gt><lt>ds:RSAKeyValue<gt><lt>ds:Modulus<gt><base64_block><lt>/ds:Modulus<gt><lt>ds:Exponent<gt>AQAB<lt>/ds:Exponent<gt><lt>/ds:RSAKeyValue<gt><lt>/ds:KeyValue<gt><nl><lt>/ds:KeyInfo<gt>

# --- algorithm URIs ---
<c14n_algorithm> = http://www.w3.org/2001/10/xml-exc-c14n#
<c14n_algorithm> = [weight=1] http://www.w3.org/TR/2001/REC-xml-c14n-20010315
<c14n_algorithm> = [weight=1] http://www.w3.org/2001/10/xml-exc-c14n#WithComments

<sig_algorithm> = http://www.w3.org/2001/04/xmldsig-more#rsa-sha256
<sig_algorithm> = [weight=1] http://www.w3.org/2000/09/xmldsig#rsa-sha1
<sig_algorithm> = [weight=1] http://www.w3.org/2001/04/xmldsig-more#rsa-sha384
<sig_algorithm> = [weight=1] http://www.w3.org/2001/04/xmldsig-more#rsa-sha512

<digest_algorithm> = http://www.w3.org/2001/04/xmlenc#sha256
<digest_algorithm> = [weight=1] http://www.w3.org/2000/09/xmldsig#sha1
<digest_algorithm> = [weight=1] http://www.w3.org/2001/04/xmlenc#sha512

# --- base64 placeholder blocks ---
<base64_block> = <string min=20 max=60 charset=alphanumeric>
<base64_block> = [weight=1] <string min=60 max=120 charset=alphanumeric>

# =============================================================================
# Edge cases and attack surface extensions
# =============================================================================

# --- EncryptedAssertion wrapper ---
<assertion_elem> = [weight=1] <lt>saml:EncryptedAssertion<gt><lt>xenc:EncryptedData xmlns:xenc=<quot>http://www.w3.org/2001/04/xmlenc#<quot><gt><lt>xenc:CipherData<gt><lt>xenc:CipherValue<gt><base64_block><lt>/xenc:CipherValue<gt><lt>/xenc:CipherData<gt><lt>/xenc:EncryptedData<gt><lt>/saml:EncryptedAssertion<gt>

# --- Extensions element (container for XSW7) ---
<response_body> = [weight=1] <issuer_elem><nl><status_elem><nl><lt>samlp:Extensions<gt><assertion_elem><lt>/samlp:Extensions<gt><nl><assertion_elem_signed>

# --- XML comment injection points ---
<nameid_value> = [weight=1] admin<lt>!-- comment --<gt>@evil.com
<nameid_value> = [weight=1] admin@example.com<lt>!-- --<gt>

# --- Namespace edge cases ---
<assertion_elem> = [weight=1] <lt>saml:Assertion xmlns:saml=<quot><saml_ns><quot> xmlns:evil=<quot>relative-uri<quot> Version=<quot>2.0<quot> ID=<quot><assertion_id><quot> IssueInstant=<quot><timestamp><quot><gt><nl><assertion_body><nl><lt>/saml:Assertion<gt>

# --- Duplicate ID attribute (S2 attribute pollution) ---
<assertion_elem> = [weight=1] <lt>saml:Assertion xmlns:saml=<quot><saml_ns><quot> Version=<quot>2.0<quot> ID=<quot><assertion_id><quot> samlp:ID=<quot><assertion_id><quot> IssueInstant=<quot><timestamp><quot><gt><nl><assertion_body><nl><lt>/saml:Assertion<gt>
