<?xml version="1.0" encoding="utf-8"?>
<domain xmlns="http://www.tmaxsoft.com/xml/ns/jeus" version="8.0">
    <production-mode>true</production-mode>
    <id>20180910</id>
    <admin-server-name>jeus8</admin-server-name>
    <security-manager>
        <default-application-domain>SYSTEM_DOMAIN</default-application-domain>
        <security-domains>
            <security-domain>
                <name>SYSTEM_DOMAIN</name>
            </security-domain>
        </security-domains>
    </security-manager>
    <domain-log-home>logs</domain-log-home>
    <servers>
        <server>
            <name>jeus8</name>
            <jvm-config>
                <jvm-option>-Xms512m -Xmx512m</jvm-option>
            </jvm-config>
            <class-ftp>true</class-ftp>
            <listeners>
                <base>base</base>
                <listener>
                    <name>base</name>
                    <listen-port>9736</listen-port>
                    <listen-address>0.0.0.0</listen-address>
                </listener>
                <listener>
                    <name>http-server</name>
                    <listen-port>8080</listen-port>
                    <listen-address>0.0.0.0</listen-address>
                    <keep-alive-timeout>600000</keep-alive-timeout>
                </listener>
            </listeners>
            <web-engine>
                <web-connections>
                    <http-listener>
                        <name>http</name>
                        <server-listener-ref>http-server</server-listener-ref>
                        <thread-pool>
                            <min>10</min>
                            <max>50</max>
                        </thread-pool>
                    </http-listener>
                    <webtob-connector>
                        <name>webtob-conn</name>
                        <thread-pool>
                            <number>10</number>
                        </thread-pool>
                        <registration-id>MyGroup</registration-id>
                        <hth-count>1</hth-count>
                        <network-address>
                            <port>9900</port>
                            <ip-address>webtob</ip-address>
                        </network-address>
                    </webtob-connector>
                </web-connections>
            </web-engine>
            <system-logging>
                <name>jeus</name>
                <level>INFO</level>
                <handler>
                    <file-handler>
                        <name>fileHandler</name>
                        <valid-day>1</valid-day>
                    </file-handler>
                </handler>
            </system-logging>
        </server>
    </servers>
    <deployed-applications>
        <deployed-application>
            <id>examples</id>
            <path>/home/tmax/app/examples.ear</path>
            <type>EAR</type>
            <target-all-servers>true</target-all-servers>
            <classloading>ISOLATED</classloading>
            <use-fast-deploy>false</use-fast-deploy>
            <keep-generated>false</keep-generated>
            <shared>false</shared>
            <node-java-context>false</node-java-context>
        </deployed-application>
    </deployed-applications>
</domain>
